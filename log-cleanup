#!/bin/bash
# run weekly from /etc/cron.weekly/
# delete logs older than 30 days

# 1. Vacuum systemd journal to exactly 30 days
/usr/bin/journalctl --vacuum-time=30d

# 2. Delete rotated/compressed logs in /var/log older than 30 days
/usr/bin/find /var/log -type f \( -name "*.log.*" -o -name "*.gz" \) -mtime +30 -delete

# 3. Clean up Samba-specific logs
if [ -d "/var/log/samba" ]; then
    /usr/bin/find /var/log/samba -type f -mtime +30 -delete
fi

exit 0
